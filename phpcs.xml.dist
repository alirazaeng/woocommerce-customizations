<?xml version="1.0"?>
<ruleset name="WooCommerce Customizations">
	<description>WordPress Coding Standards for the WooCommerce Customizations repository.</description>

	<file>plugin</file>
	<file>examples</file>

	<exclude-pattern>vendor/*</exclude-pattern>

	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg value="sp"/>

	<rule ref="WordPress-Core"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="WordPress-Extra"/>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="arwc"/>
				<element value="ARWC"/>
			</property>
		</properties>
	</rule>
</ruleset>
